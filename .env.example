# Copy to .env and fill OPENAI_API_KEY before running anything.
# .env is gitignored; this template is the only file that lists the vars.

# OpenAI API key — REQUIRED, no default. Settings raises loudly if unset or empty.
OPENAI_API_KEY=

# Classification model. gpt-4o-mini is the cheap/fast default; gpt-4o is
# reserved as a hard-case fallback (§2) and gets wired in Phase 3.
OPENAI_MODEL=gpt-4o-mini

# Embedding model for SOP ingestion + retrieval (§2).
EMBEDDING_MODEL=text-embedding-3-small

# Persisted ChromaDB location. Directory contents are gitignored.
CHROMA_PATH=./data/chroma_db

# Structured-log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
